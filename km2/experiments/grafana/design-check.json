   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineInterpolation": "stepAfter",
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 19
   },
   "id": 8,
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   }
  },
  {
   "type": "timeseries",
   "title": "HPA の数 (設計: 0)",
   "description": "HPA があると台数が勝手に変わる。0 のままなら HPA 無し。",
   "targets": [
    {
     "refId": "A",
     "expr": "count(kube_horizontalpodautoscaler_info{namespace=\"$ns\"}) or vector(0)",
     "legendFormat": "HPA の数",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineInterpolation": "stepAfter",
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 19
   },
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   }
  },
  {
   "type": "bargauge",
   "title": "requests (予約枠) [ミリコア] ↔ CSV の req_mc",
   "description": "区間の終わりの時刻での設定値。",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by(deploy, container)(label_replace(kube_pod_container_resource_requests{namespace=\"$ns\",resource=\"cpu\"}, \"deploy\", \"$1\", \"pod\", \"(.+)-[a-f0-9]{6,}-[a-z0-9]+\")) * 1000",
     "instant": true,
     "range": false,
     "legendFormat": "{{deploy}} / {{container}}  requests 合計 m"
    },
    {
     "refId": "B",
     "expr": "max by(deploy, container)(label_replace(kube_pod_container_resource_requests{namespace=\"$ns\",resource=\"cpu\"}, \"deploy\", \"$1\", \"pod\", \"(.+)-[a-f0-9]{6,}-[a-z0-9]+\")) * 1000",
     "instant": true,
     "range": false,
     "legendFormat": "{{deploy}} / {{container}}  1 Pod あたり m"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "text",
    "namePlacement": "left",
    "sizing": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false,
     "fields": ""
    }
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 0,
    "y": 27
   },
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   }
  },
  {
   "type": "bargauge",
   "title": "limits (上限) [ミリコア] ↔ CSV の lim_mc",
   "description": "mix-cpu2 の設計: frontend と productcatalogservice は 3000m、adservice は 1000m に上書き。",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by(deploy, container)(label_replace(kube_pod_container_resource_limits{namespace=\"$ns\",resource=\"cpu\"}, \"deploy\", \"$1\", \"pod\", \"(.+)-[a-f0-9]{6,}-[a-z0-9]+\")) * 1000",
     "instant": true,
     "range": false,
     "legendFormat": "{{deploy}} / {{container}}  limits 合計 m"
    },
    {
     "refId": "B",
     "expr": "max by(deploy, container)(label_replace(kube_pod_container_resource_limits{namespace=\"$ns\",resource=\"cpu\"}, \"deploy\", \"$1\", \"pod\", \"(.+)-[a-f0-9]{6,}-[a-z0-9]+\")) * 1000",
     "instant": true,
     "range": false,
     "legendFormat": "{{deploy}} / {{container}}  1 Pod あたり m"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "showUnfilled": true,
    "valueMode": "text",
    "namePlacement": "left",
    "sizing": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false,
     "fields": ""
    }
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 12,
    "y": 27
   },
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   }
  },
  {
   "type": "row",
   "title": "③ 負荷をかけた時間 — k6 の Pod (スクリプトとは別の記録)",
   "collapsed": false,
