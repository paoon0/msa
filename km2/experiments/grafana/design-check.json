  {
   "type": "timeseries",
   "title": "k6 の Pod が動いていたか (1 = Running)",
   "description": "kube-state-metrics の記録 (30 秒ごと) なので、始まりと終わりは最大 30 秒ずれて見える。正確な開始時刻は Explore で kube_pod_container_state_started{pod=~\"k6load.*\"} を見る (値が unix 秒)。",
   "targets": [
    {
     "refId": "A",
     "expr": "max by(pod)(kube_pod_status_phase{namespace=\"$ns\",pod=~\"k6load.*\",phase=\"Running\"})",
     "legendFormat": "{{pod}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineInterpolation": "stepAfter",
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 38
   },
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   }
  },
  {
   "type": "timeseries",
   "title": "k6 の CPU [ミリコア] (負荷をかけている間だけ上がる)",
   "description": "10 秒ごとの記録から 1 分の移動平均。立ち上がりと落ち込みの時刻が、負荷をかけていた時間の目安になる。",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by(pod)(rate(container_cpu_usage_seconds_total{namespace=\"$ns\",pod=~\"k6load.*\",container!=\"\",container!=\"POD\"}[1m])) * 1000",
     "legendFormat": "{{pod}}",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineInterpolation": "stepAfter",
